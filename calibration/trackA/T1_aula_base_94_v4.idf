Output:Variable, *, Zone Air CO2 Concentration, daily;
Output:Variable, *, Zone Air CO2 Concentration, monthly;
Output:Variable, *, Zone Air CO2 Concentration, runperiod;
OutputControl:ReportingTolerances,1.11,1.11;
Output:Diagnostics, DisplayAdvancedReportVariables;

!- EMS Code
!- EMS Program: ZC_Output window open factor

! Program requires:
! windows are open factor result.

Output:Variable, *, AFN Node CO2 Concentration, Timestep;
Output:Variable, *, Zone Air CO2 Concentration, Timestep;
!- EMS Program: ZC_People occupant count

! Program requires:
! people counter result.

Output:Variable, *, People Occupant Count, Timestep;

!- EMS Program: ZC_C02 Window openning factor algorithm_N&S: 22cm-max(half window)

! Program requires:
!   - Calculated natural ventilation
!   - CO2 control switched on at site level
! windows always close when the zone CO2 levels < 400ppm.
! windows still close when the zone CO2 levels > 400ppm, and <800ppm if the CO2 level trend is postive.
! windows opened when the zone CO2 levels > 800ppm based on opening availability and when Nat vent on at zone level.
! windows are still opened when the zone CO2 levels > 400ppm if the CO2 level trend is quasi negative.

EnergyManagementSystem:Sensor,
   ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_WinAir_CO2_Concentration,
   ZXCASESTUDYCLASSROOM:CLASSROOM,
   Zone Air CO2 Concentration;

EnergyManagementSystem:Actuator,
   Venting_Opening_Factor_ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_Win,
   ZXCASESTUDYCLASSROOM:CLASSROOM_Wall_3_0_0_0_0_2_Win,
   AirFlow Network Window/Door Opening,
   Venting Opening Factor;
EnergyManagementSystem:TrendVariable,
CO2_trend_log_ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_Win,                  !- Name
ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_WinAir_CO2_Concentration,           !- EMS Variable Name
120;
                                                    !- Number of Timesteps to be Logged

EnergyManagementSystem:GlobalVariable,
CO2_previous_state_dir_ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_Win;
EnergyManagementSystem:OutputVariable ,
CO2 2tstep dir ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_Win,                 ! Name
CO2_previous_state_dir_ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_Win,         ! EMS Variable Name
Averaged ,                                               ! Type of Data in Variable
ZoneTimeStep;
                                           ! Update Frequency

Output:Variable, *, CO2 2tstep dir ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_0_0_2_Win, Timestep;

EnergyManagementSystem:Sensor,
   ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_1_0_1_WinAir_CO2_Concentration,
   ZXCASESTUDYCLASSROOM:CLASSROOM,
   Zone Air CO2 Concentration;

EnergyManagementSystem:Actuator,
   Venting_Opening_Factor_ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_1_0_1_Win,
   ZXCASESTUDYCLASSROOM:CLASSROOM_Wall_3_0_0_1_0_1_Win,
   AirFlow Network Window/Door Opening,
   Venting Opening Factor;
EnergyManagementSystem:TrendVariable,
CO2_trend_log_ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_1_0_1_Win,                  !- Name
ZXCASESTUDYCLASSROOM_CLASSROOM_Wall_3_0_0_1_0_1_WinAir_CO2_Concentration,           !- EMS Variable Name
120;
                                                    !- Number of Timesteps to be Logged

EnergyManagementSystem:GlobalVariable,
