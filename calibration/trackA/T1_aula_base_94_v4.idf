   1.0,                                           !- Ratio of frame-edge glass conductance to centre of glass conductance
   0.3,                                           !- Frame Solar Absorptance
   0.3,                                           !- Frame Visible Absorptance
   0.3,                                           !- Frame Thermal Emissivity
   DividedLite,                                   !- Divider Type
   ,                                              !- Divider Width
   0,                                             !- Number of Horzontal Dividers
   0,                                             !- Number of Vertical Dividers
   ,                                              !- Divider Outside Projection
   ,                                              !- Divider Inside Projection
   ,                                              !- Divider Conductance
   ,                                              !- Ratio of divider-edge glass conductance to centre of glass conductance
   ,                                              !- Divider Solar Absorptance
   ,                                              !- Divider Visible Absorptance
   ,                                              !- Divider Thermal Emissivity
   0.3,                                           !- Outside Reveal Solar Absorptance
   0.0,                                           !- Inside Sill Depth
   0.3,                                           !- Inside Sill Solar Absorptance
   .3,                                            !- Inside Reveal Depth
   0.3;                                           !- Inside Reveal Solar Absorptance

